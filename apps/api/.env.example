NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/auth
# Generate with: openssl rand -hex 32  (each must be at least 32 characters, and different)
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-too-change-me-too-change-me-too
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
# Set to true only when running behind a reverse proxy (nginx in docker-compose); it makes
# X-Forwarded-* headers trusted for client IP (rate limiting) and protocol detection.
TRUST_PROXY=false
# Secure flag on the refresh cookie. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
